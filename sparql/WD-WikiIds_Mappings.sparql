#title: Core Wikimedia projects with both project type name (?sitename) and specific wiki name (?sitenameFull)
# Source: https://wikitech.wikimedia.org/wiki/MediaWiki_Content_File_Exports/WikiId_Mappings
SELECT DISTINCT ?wiki_id ?hostname ?type ?language ?sitename ?sitenameFull WHERE {
  {
    # Branch 1: Language editions mapped to their core project item
    VALUES (?projectClass ?type ?projectItem) {
      (wd:Q10876391  "wikipedia"   wd:Q52)     # Wikipedia
      (wd:Q151885    "wiktionary"  wd:Q151)    # Wiktionary
      (wd:Q15156455  "wikibooks"   wd:Q367)    # Wikibooks
      (wd:Q15156406  "wikinews"    wd:Q964)    # Wikinews
      (wd:Q15156451  "wikiquote"   wd:Q369)    # Wikiquote
      (wd:Q15156456  "wikisource"  wd:Q263)    # Wikisource
      (wd:Q15156458  "wikiversity" wd:Q370)    # Wikiversity
      (wd:Q15156459  "wikivoyage"  wd:Q373)    # Wikivoyage
    }
    ?item wdt:P31 ?projectClass .
  }
  UNION
  {
    # Branch 2: Global / Multilingual projects (project item is itself)
    VALUES (?item ?type ?projectItem) {
      (wd:Q565       "commons"     wd:Q565)
      (wd:Q2013      "wikidata"    wd:Q2013)
      (wd:Q13679     "species"     wd:Q13679)
      (wd:Q15633578  "wikifunctions" wd:Q15633578)
      (wd:Q1063116   "meta"        wd:Q1063116)
      (wd:Q15156769  "incubator"   wd:Q15156769)
      (wd:Q83        "mediawiki"   wd:Q83)
    }
  }

  ?item wdt:P1800 ?wiki_id ;
        wdt:P856 ?hostname .

  # Retrieve language code
  OPTIONAL {
    ?item wdt:P407 ?langItem .
    ?langItem wdt:P424 ?language .
  }
  BIND(COALESCE(?language, "en") AS ?language)

  # 1. Localized project type name (?sitename) e.g., "Wikipedia" -> "維基百科"
  OPTIONAL {
    ?projectItem rdfs:label ?sitenameRaw .
    FILTER(LANG(?sitenameRaw) = ?language)
  }
  OPTIONAL {
    ?projectItem rdfs:label ?sitenameEn .
    FILTER(LANG(?sitenameEn) = "en")
  }
  BIND(COALESCE(?sitenameRaw, ?sitenameEn) AS ?sitename)

  # 2. Specific wiki instance native name (?sitenameFull) e.g., "Abkhazian Wikipedia" -> "Авикипедиа"
  OPTIONAL {
    ?item rdfs:label ?sitenameFullRaw .
    FILTER(LANG(?sitenameFullRaw) = ?language)
  }
  OPTIONAL {
    ?item rdfs:label ?sitenameFullEn .
    FILTER(LANG(?sitenameFullEn) = "en")
  }
  BIND(COALESCE(?sitenameFullRaw, ?sitenameFullEn) AS ?sitenameFull)

  # Exclude closed/locked wikis
  FILTER NOT EXISTS { ?item wdt:P31 wd:Q19826567 }
}
ORDER BY ?wiki_id
