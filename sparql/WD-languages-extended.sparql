SELECT 
  ?language
  ?languageLabel 
  ?nativeLabel
  ?population
  ?type
  ?iso639_1
  ?iso639_2
  ?iso639_3
  ?lingualibreId
  ?ethnologueStatusLabel
WHERE {
  {
    SELECT 
      ?language
      (SAMPLE(?nativeLabel) AS ?nativeLabel)
      (SAMPLE(?population) AS ?population)
      (COALESCE(SAMPLE(?signedCheck), "spoken") AS ?type)
      (SAMPLE(?iso639_1) AS ?iso639_1)
      (SAMPLE(?iso639_2) AS ?iso639_2)
      (SAMPLE(?iso639_3) AS ?iso639_3)
      (SAMPLE(?lingualibreId) AS ?lingualibreId)
      (SAMPLE(?ethnologueStatus) AS ?ethnologueStatus)
    WHERE {
      VALUES ?languages { 
        wd:Q34770    # language
        wd:Q20162172 # human language 
        wd:Q33742    # natural language
        wd:Q34228    # signed language
        wd:Q1288568  # modern language
        wd:Q33384    # dialect
        wd:Q45762    # dead language
        wd:Q38058796 # extinct language.
      }
      ?language wdt:P31 ?languages .

      # Check for signed language without triggering the EXISTS parser bug
      OPTIONAL {
        ?language wdt:P31 wd:Q34228 .
        BIND("signed" AS ?signedCheck)
      }

      OPTIONAL { ?language wdt:P1705 ?nativeLabel . }
      OPTIONAL { ?language wdt:P1098 ?population . }
      OPTIONAL { ?language wdt:P3823 ?ethnologueStatus . }
      OPTIONAL { ?language wdt:P218 ?iso639_1 . }
      OPTIONAL { ?language wdt:P219 ?iso639_2 . }
      OPTIONAL { ?language wdt:P220 ?iso639_3 . }
      OPTIONAL { ?language wdt:P10369 ?lingualibreId . }
    }
    GROUP BY ?language
  }
  
  ### Resolve labels outside the subquery
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
ORDER BY ASC(?type)
